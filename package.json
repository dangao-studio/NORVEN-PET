{
  "name": "novum-pet",
  "productName": "NovumPet",
  "version": "1.0.1",
  "description": "諾文桌寵",
  "author": "dangao-studio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.dangao.novumpet",
    "productName": "NovumPet",
    "files": ["main.js", "preload.js", "package.json", "app/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "諾文桌寵",
      "artifactName": "NovumPet-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "NovumPet-Portable-${version}.exe"
    }
  }
}
